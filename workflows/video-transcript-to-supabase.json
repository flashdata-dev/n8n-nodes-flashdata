{
  "name": "FlashData - Timestamped video transcript archive in Supabase",
  "active": false,
  "nodes": [
    {
      "id": "run-manually",
      "name": "Run manually",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        240
      ],
      "parameters": {}
    },
    {
      "id": "video-settings",
      "name": "Video settings",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        240,
        240
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "videoUrl",
              "name": "videoUrl",
              "value": "https://www.youtube.com/watch?v=dQw4w9WgXcQ",
              "type": "string"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "get-transcript",
      "name": "Get transcript",
      "type": "n8n-nodes-flashdata.flashdata",
      "typeVersion": 1,
      "position": [
        480,
        240
      ],
      "parameters": {
        "resource": "youtube",
        "operation": "getTranscript",
        "videoId": "={{$json.videoUrl}}",
        "language": "en",
        "auto": true
      }
    },
    {
      "id": "split-caption-segments",
      "name": "Split caption segments",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [
        720,
        240
      ],
      "parameters": {
        "fieldToSplitOut": "results[0].segments",
        "include": "allOtherFields",
        "options": {
          "destinationFieldName": "segment"
        }
      }
    },
    {
      "id": "transcript-row",
      "name": "Transcript row",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        960,
        240
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "video_id",
              "name": "video_id",
              "value": "={{ $('Get transcript').first().json.results[0].videoId }}",
              "type": "string"
            },
            {
              "id": "source_url",
              "name": "source_url",
              "value": "={{ 'https://www.youtube.com/watch?v=' + $('Get transcript').first().json.results[0].videoId + '&t=' + Math.floor($json.segment.start) }}",
              "type": "string"
            },
            {
              "id": "language",
              "name": "language",
              "value": "={{ $('Get transcript').first().json.results[0].languageCode }}",
              "type": "string"
            },
            {
              "id": "is_auto_generated",
              "name": "is_auto_generated",
              "value": "={{ $('Get transcript').first().json.results[0].isAutoGenerated }}",
              "type": "boolean"
            },
            {
              "id": "captured_at",
              "name": "captured_at",
              "value": "={{ $('Get transcript').first().json.created_at }}",
              "type": "string"
            },
            {
              "id": "start_seconds",
              "name": "start_seconds",
              "value": "={{$json.segment.start}}",
              "type": "number"
            },
            {
              "id": "end_seconds",
              "name": "end_seconds",
              "value": "={{$json.segment.end}}",
              "type": "number"
            },
            {
              "id": "text",
              "name": "text",
              "value": "={{$json.segment.text}}",
              "type": "string"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "store-segments-in-supabase",
      "name": "Store segments in Supabase",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        1200,
        240
      ],
      "parameters": {
        "resource": "row",
        "operation": "create",
        "tableId": "flashdata_transcript_segments",
        "dataToSend": "autoMapInputData"
      }
    },
    {
      "id": "setup-instructions",
      "name": "Setup instructions",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        0,
        -40
      ],
      "parameters": {
        "content": "## Setup\nRun the supplied SQL in your own Supabase project. Select FlashData and Supabase credentials. Edit Video settings and caption language/type. Each caption segment is stored with its video URL and capture time. Re-running appends another snapshot. This collects source material for a knowledge base; add chunking, embeddings and retrieval separately. See workflows/README.md.",
        "height": 210,
        "width": 690
      }
    }
  ],
  "connections": {
    "Run manually": {
      "main": [
        [
          {
            "node": "Video settings",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Video settings": {
      "main": [
        [
          {
            "node": "Get transcript",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get transcript": {
      "main": [
        [
          {
            "node": "Split caption segments",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Split caption segments": {
      "main": [
        [
          {
            "node": "Transcript row",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Transcript row": {
      "main": [
        [
          {
            "node": "Store segments in Supabase",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "UTC"
  },
  "pinData": {},
  "tags": []
}
